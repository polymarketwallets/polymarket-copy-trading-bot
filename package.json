{
  "name": "pmwallets-copytrade",
  "version": "0.1.4",
  "description": "Ready-to-run Polymarket copy-trading bot: follows the wallets you subscribe to on PMWallets and mirrors their trades on the Polymarket CLOB, with dry-run, risk caps and exactly-once fill handling.",
  "type": "module",
  "bin": {
    "pmwallets-copytrade": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "config.example.yaml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "polymarket",
    "copy-trading",
    "copytrade",
    "trading-bot",
    "prediction-markets",
    "pmwallets"
  ],
  "homepage": "https://pmwallets.com/copy-trading",
  "license": "MIT",
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.1.0",
    "https-proxy-agent": "^7.0.6",
    "pmwallets": "^0.1.0",
    "undici": "^7.29.1",
    "viem": "^2.46.3",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polymarketwallets/polymarket-copy-trading-bot.git"
  },
  "bugs": {
    "url": "https://github.com/polymarketwallets/polymarket-copy-trading-bot/issues"
  }
}
